# Google Calendar - um único OAuth Client para toda a plataforma
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/admin/integrations/google/callback
# false = se o Google conectado estiver indisponível, não oferece horários (mais seguro)
# true  = ignora falha do Google e usa somente a agenda interna
GOOGLE_AVAILABILITY_FAIL_OPEN=false

# Base64 de uma chave AES-256 (32 bytes)
INTEGRATION_ENCRYPTION_KEY=

# Pagamento opcional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail transacional
RESEND_API_KEY=
EMAIL_FROM=

# Processamento assincrono
OUTBOX_SECRET=

# Bootstrap administrativo (somente CLI; não exponha no runtime da aplicação)
# AGENDA_BOOTSTRAP_EMAIL=admin@seudominio.com
# AGENDA_BOOTSTRAP_NAME=Administrador Master
# AGENDA_BOOTSTRAP_PASSWORD=uma-senha-forte-e-temporaria
